{
  "name": "TripoSR",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.example.gradio",
    "productName": "GradioApp",
    "directories": {
      "buildResources": "resources"
    },
    "files": [
      "**/*",
      "!dist/*"
    ],
    "asar": false,
    "compression": "store",
    "asarUnpack": [
      "python-env/**",
      "backend/**"
    ],
    "linux": {
      "target": ["AppImage"],
      "category": "Utility",
      "icon": "backend/examples/chair.png"
    }
  },
  "devDependencies": {
    "electron": "^39",
    "electron-builder": "^26"
  }
}

